# Canonical origin, no trailing slash. Used for metadataBase, sitemap,
# robots.txt and absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=

# Search Console / verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend — powers the /api/contact route. Get the key from
# https://resend.com/api-keys. CONTACT_FROM_EMAIL's domain must be verified
# in Resend (Domains tab) before it can send; CONTACT_TO_EMAIL/FROM_EMAIL
# default to letstalk@fcfilmwerks.com if left blank.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="FC Filmwerks <letstalk@fcfilmwerks.com>"
CONTACT_TO_EMAIL=letstalk@fcfilmwerks.com
